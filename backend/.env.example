# ===========================================================================
# GD Diagnóstico Logístico — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste para o seu ambiente.
# NUNCA commite o arquivo .env no repositório.
# ===========================================================================

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | production

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
PROJECT_NAME="GD Diagnóstico Logístico"
VERSION=2.0.0
DEBUG=true                        # false em produção

# ---------------------------------------------------------------------------
# Banco de Dados
# ---------------------------------------------------------------------------
# LOCAL (SQLite — apenas para desenvolvimento sem Docker):
# DATABASE_URL=sqlite:///./gd_frete.db

# DOCKER / PRODUÇÃO (PostgreSQL):
DATABASE_URL=postgresql+psycopg2://gd_user:gd_pass@db:5432/gd_frete

# ---------------------------------------------------------------------------
# Segurança / JWT
# ---------------------------------------------------------------------------
# OBRIGATÓRIO em produção — gere com: openssl rand -hex 32
SECRET_KEY=SUBSTITUA-POR-CHAVE-FORTE-32-BYTES-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30    # access token curto (R-05/R-06)
REFRESH_TOKEN_EXPIRE_DAYS=7       # refresh token de longa duração (R-05)

# ---------------------------------------------------------------------------
# CORS — origens permitidas para o frontend
# ---------------------------------------------------------------------------
# Desenvolvimento:
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Produção (adicione o domínio real):
# BACKEND_CORS_ORIGINS=https://app.gdconecta.com.br

# ---------------------------------------------------------------------------
# Usuário administrador inicial (seed — alterar senha após o primeiro login)
# ---------------------------------------------------------------------------
FIRST_SUPERUSER_EMAIL=admin@gdconecta.com.br
FIRST_SUPERUSER_PASSWORD=Admin@123456
FIRST_SUPERUSER_NAME="Administrador GD Conecta"

# ---------------------------------------------------------------------------
# Limites de importação
# ---------------------------------------------------------------------------
MAX_CTE_BATCH=10000

# ---------------------------------------------------------------------------
# PostgreSQL (usadas pelo docker-compose — separadas da DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=gd_user
POSTGRES_PASSWORD=gd_pass
POSTGRES_DB=gd_frete
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================================================================
# V4 — INTELIGÊNCIA LOGÍSTICA COM IA
# ===========================================================================

# Modo simulado: True = respostas mock sem custo (sem chaves de API).
# Quando obtiver as chaves, mude para False e preencha abaixo.
AI_SIMULATION_MODE=True

# Chaves de API (preencha quando obtiver)
# OpenAI:    https://platform.openai.com  -> API Keys
# Anthropic: https://console.anthropic.com -> API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos
AI_MODEL_PRINCIPAL=gpt-4.1
AI_MODEL_VOLUME=claude-haiku-4-5

# Câmbio para custo estimado em BRL
USD_TO_BRL=5.90

# Redis (Celery broker + cache) — sobe via Docker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AI_CACHE_TTL=86400

# RAG / pgvector (só funciona em PostgreSQL — Opção B)
RAG_ENABLED=True
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
